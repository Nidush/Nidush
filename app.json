{
  "expo": {
    "name": "Nidush",
    "slug": "Nidush",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Icon-Padded.png",
    "scheme": "nidush",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nidush.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Nidush needs access to your health data to monitor heart rate and activity levels."
      }
    },
    "android": {
      "package": "com.nidush.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Icon-Padded.png"
      },
      "edgeToEdgeEnabled": true,
        "permissions": [
          "android.permission.POST_NOTIFICATIONS",
          "android.permission.RECORD_AUDIO",
          "android.permission.MODIFY_AUDIO_SETTINGS",
          "android.permission.health.READ_HEART_RATE",
          "android.permission.health.READ_RESTING_HEART_RATE",
          "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
        ],
      "intentFilters": [
        {
          "action": "VIEW_PERMISSION_USAGE",
          "category": [
            "HEALTH_PERMISSIONS"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0F2EB"
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-video",
      "expo-asset",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "expandedController": true
        }
      ],
      [
        "react-native-health-connect",
        {
          "privacyPolicyUrl": "https://nidush.app/privacy",
          "permissions": [
            {
              "accessType": "read",
              "recordType": "HeartRate"
            },
            {
              "accessType": "read",
              "recordType": "RestingHeartRate"
            },
            {
              "accessType": "read",
              "recordType": "BackgroundAccessPermission"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-web-browser",
      "expo-background-task"
    ],
    "extra": {
      "eas": {
        "projectId": "c61332b1-8bad-4bc9-9b37-fcb56e693716"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c61332b1-8bad-4bc9-9b37-fcb56e693716"
    }
  }
}
